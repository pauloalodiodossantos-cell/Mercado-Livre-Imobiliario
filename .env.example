# Copie este arquivo para .env e preencha os valores

# Banco de dados PostgreSQL (não necessário para npm run dev:demo)
DATABASE_URL="postgresql://user:password@localhost:5432/mercado_livre_imoveis"

# Segredo JWT — troque em produção!
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Porta da API (padrão: 3000)
PORT=3000
